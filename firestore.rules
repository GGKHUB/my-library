rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsLibrary(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validBook() {
      return request.resource.data.keys().hasOnly([
          'title', 'author', 'isbn', 'location', 'description', 'tags', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 200
        && request.resource.data.isbn is string
        && request.resource.data.isbn.size() <= 30
        && request.resource.data.location in ['Home', 'Work', 'Loaned', 'Unknown']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.tags is list
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId}/books/{bookId} {
      allow get, list: if ownsLibrary(userId);
      allow create, update: if ownsLibrary(userId) && validBook();
      allow delete: if ownsLibrary(userId);
    }
  }
}

